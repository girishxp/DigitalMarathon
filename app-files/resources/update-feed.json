{
  "provider": "github-portable",
  "owner": "girishxp",
  "repo": "DigitalMarathon",
  "assetPattern": "^digital-marathon-cross-platform-v([0-9]+\\.[0-9]+\\.[0-9]+)-click-to-launch\\.zip$",
  "checksumPattern": "SHA256SUMS-v<version>.txt",
  "startupCheckDelayMs": 2500,
  "checkIntervalMinutes": 15,
  "remindLaterHours": 24,
  "requireSha256": true,
  "installation": "verified-download-manual-extract",
  "fallbackMetadataUrl": "https://github.com/girishxp/DigitalMarathon/releases/latest/download/digital-marathon-update.json",
  "fallbackConditions": [
    "github-api-rate-limit",
    "github-api-outage",
    "github-api-connection-failure"
  ],
  "metadataSchema": 1,
  "metadataMaxBytes": 65536,
  "requireAppIdentity": true
}
